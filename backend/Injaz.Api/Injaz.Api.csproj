<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Injaz.Api</RootNamespace>
		<UserSecretsId>injaz-api-7f3c2a91</UserSecretsId>
		<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
	</PropertyGroup>

	<ItemGroup>
		<!-- إعدادات التطوير ما تتنشرش على السيرفر -->
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Scalar.AspNetCore" Version="2.*" />
	</ItemGroup>

	<!-- عند النشر (dotnet publish أو Publish من Visual Studio): بناء الواجهة بـ Vite ونسخها إلى wwwroot.
	     لتخطي الخطوة دي: dotnet publish -p:SkipFrontend=true -->
	<PropertyGroup>
		<FrontendRoot>$(MSBuildProjectDirectory)\..\..\</FrontendRoot>
	</PropertyGroup>

	<Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipFrontend)' != 'true'">
		<Exec WorkingDirectory="$(FrontendRoot)" Command="npm install --no-audit --no-fund" />
		<Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
		<ItemGroup>
			<FrontendDist Include="$(FrontendRoot)dist\**\*" />
			<ResolvedFileToPublish Include="@(FrontendDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
				<RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
